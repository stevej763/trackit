# Copy to .env and fill in. Everything here has a working default except the
# API keys, and TrackIt runs fine without those - search is disabled and you add
# titles by hand.

# ---------------------------------------------------------------------------
# Where the app is served
# ---------------------------------------------------------------------------
# Host port. http://localhost:8300 by default.
TRACKIT_PORT=8300

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# By default compose.override.yaml runs a local Postgres container ("db").
# For prod against an external Postgres, uncomment COMPOSE_FILE so that file
# is no longer merged in (no db container is created), then point DB_HOST at
# your server. Create the database and its owner there first, e.g.
#   CREATE ROLE trackit LOGIN PASSWORD '...';
#   CREATE DATABASE trackit OWNER trackit;
# Flyway creates the tables (and the citext extension) on the api's first start.
#COMPOSE_FILE=compose.yaml

# Host and port of Postgres as the containers see it. "db" is the local
# container; use host.docker.internal for a Postgres on the Docker host itself.
DB_HOST=db
DB_PORT=5432

# disable, prefer, require, verify-ca or verify-full. prefer uses TLS when the
# server offers it; use require (or stricter) for a database across a network.
DB_SSLMODE=prefer

POSTGRES_USER=trackit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trackit

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# The backup service writes a pg_dump to ./backups this often, and deletes
# dumps older than BACKUP_KEEP_DAYS. Copy ./backups off this machine as well.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Major version of the backup service's pg_dump. It must be at least the
# version of the Postgres server above (pg_dump refuses a newer server).
BACKUP_PG_VERSION=16

# ---------------------------------------------------------------------------
# Film and TV metadata: The Movie Database
# ---------------------------------------------------------------------------
# Free. Sign up at https://www.themoviedb.org/signup, then
# Settings -> API -> "Create" and request a Developer key. Copy the long value
# labelled "API Read Access Token" (it starts with "eyJ"): it is sent in a
# header, so it never appears in a URL or a log. The shorter v3 "API Key" (32
# hex characters) also works, but has to travel in the query string.
TMDB_API_KEY=

# ---------------------------------------------------------------------------
# Game metadata: IGDB (authenticates via Twitch)
# ---------------------------------------------------------------------------
# Free. Create a Twitch account, enable two-factor auth, then register an
# application at https://dev.twitch.tv/console/apps/create (OAuth redirect URL
# can be http://localhost, category "Application Integration"). The app's
# Client ID and a generated Client Secret go here.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set to true only when serving over HTTPS. A Secure cookie is dropped by the
# browser over plain HTTP, which would make login silently fail on a LAN.
TRACKIT_SECURE_COOKIE=false

# Set to false to stop new sign-ups once your own accounts exist. Existing
# accounts keep signing in; the sign-in page stops offering "Create one".
TRACKIT_ALLOW_SIGNUP=true

# When to re-fetch details likely to have changed (TV season counts, release
# years of recent titles): a Spring cron expression, in UTC. "-" turns it off.
TRACKIT_METADATA_REFRESH_CRON=0 30 4 * * *

# DEBUG logs every provider call and SQL-level problem.
TRACKIT_LOG_LEVEL=INFO
